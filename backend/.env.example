# 复制为 .env 并按需修改
# SQLite 开箱即用；生产/联调切 PostgreSQL（先 pip install psycopg2-binary 并 docker compose up -d）
DATABASE_URL=sqlite:///./dev.db

# Redis（空 = 不启用，限流退化为 DB 间隔守卫）
REDIS_URL=

# 采集策略
FETCH_DEFAULT_INTERVAL_MIN=360
OFFICIAL_SITE_INTERVAL_MIN=720
TTL_MULTIPLIER=3

# §9 后台任务（需另起 celery worker/beat；开关默认 false = 请求内同步，投递失败自动降级）
RESUME_PARSE_ASYNC=false
MATCH_ASYNC=false
IDLE_JOBS_TTL_DAYS=14

# §12.7 #7 采集入库抽标签：词典扫描零成本永远开；LLM 兜底默认关（需 LLM_API_KEY，按 cap 限成本）
JOB_TAG_LLM=false
JOB_TAG_LLM_CAP=50

# §12.7 #9 B SmartRecruiters 详情补齐（N+1，默认关）：列表接口不含职位描述，不开则
# description 恒为 NULL、语义分恒 0。**upsert 逐字段覆盖**——用纯列表结果重采一次
# 就会把已补齐的正文覆盖回 NULL，故只要配了 SR 公司（如 equinox）就务必开启。
# 成本：每轮最多 SR_DETAIL_CAP 条详情请求（0.1s/条礼貌限速），Equinox 728 条 ≈ 2~3 分钟。
SR_FETCH_DETAILS=false
SR_DETAIL_CAP=800

# ---------- §14 ⑤ 生产配置审计：密钥项 ----------
# 留空 = 该功能不启用（不是配置错误）；填写则必须是服务商签发的真实值——
# scripts/audit_production_config.py 只判长度与占位词，不打印原文、不改配置。
# 简历解析 LLM（DeepSeek / OpenAI 兼容接口；空 = 走规则兜底）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# 扫描件 PDF OCR（OpenAI 兼容视觉接口；空 = 不支持扫描件）
OCR_API_KEY=
OCR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OCR_MODEL=qwen-vl-plus
# 催进邮件通知（SMTP_HOST 空 = 不发邮件，beat 只打日志）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL=
# IM 群机器人（钉钉/企微；IM_WEBHOOK_TYPE 空 = 不推 IM）
IM_WEBHOOK_TYPE=
IM_WEBHOOK_URL=
IM_WEBHOOK_SECRET=

# 采集 UA 的联系邮箱：生产必须替换掉默认示例，否则站点按匿名爬虫处理
UA=job-direct-apply-bot/0.1 (compliant; contact: dev@example.com)

# ---------- §4.3 账号体系（JWT，HS256） ----------
# 生产必须换掉默认签名密钥（泄露即可伪造任意用户令牌）：
#   python -c "from app.services.auth import new_secret; print(new_secret())"
AUTH_SECRET=
AUTH_ACCESS_TTL_MIN=120
AUTH_REFRESH_TTL_DAYS=14
# 默认 false：用户态接口仍接受请求参数里的 user_id（兼容旧客户端）；
# 生产建议 true = 必须带 Bearer 令牌，缺失 401、越权 403。
AUTH_REQUIRED=false

# ---------- §10 简历原件静态加密（AES-GCM，应用层密钥） ----------
# 空 = 不加密（旧行为；脚本会 warn「原件明文落盘」）。生成：
#   python -c "from app.services.crypto import new_key; print(new_key())"
# 存量明文原件用 scripts/encrypt_uploads.py 就地加密（幂等）。
UPLOADS_KEY=

# ---------- §10 可观测性（日志 / 指标 / Sentry） ----------
# 一行一个 JSON，供 Loki/ES；默认 false（开发期控制台保持可读）
LOG_JSON=false
# Prometheus 抓取点：GET /metrics（文本格式，不引依赖；内容不含密钥与个人信息）
METRICS_ENABLED=true
# 非空则 /metrics 必须带同值令牌（?token= 或 Authorization: Bearer）；Prometheus 通常无凭据，默认不强制
METRICS_TOKEN=
METRICS_OPS_WINDOW_HOURS=24
# Sentry：非空且装了 sentry-sdk（pip install sentry-sdk）才初始化，否则静默跳过
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ---------- §12.5 反馈回灌闭环：权重自动采纳（默认关） ----------
# 生效权重 = match_weight_versions 最新一行（采纳走 POST /api/match-weights/apply，
# 或开启本开关后由 beat 每周一 06:00 自动采纳）；表空时回退上面的 MATCH_W_*。
# 自动采纳有双门槛：样本 ≥ WEIGHTS_AUTO_TUNE_MIN_SAMPLE 且 NDCG 提升 ≥ WEIGHTS_AUTO_TUNE_MARGIN，
# 达不到就不换参数（避免把噪声当成改进）。
# ⚠ 第二重语义（第二十五轮起，第二十六轮在本机打开）：开 = **同时启用 L1+L2 权重
# 归一打分**——match_parts 剔除"不可判定"项（无技能标签 / 城市未知 / 跨区不可比），
# weighted_rule 把缺项权重按比例摊给其余项；关 = 与旧口径逐位一致。因此**打开后必须
# 全量重算 match_scores**（否则库里是新口径、库外是旧口径）。两者绑在一起是因为它们
# 必须同时变更：只归一不分档会让 rule 退化成 role 的线性函数、并列更多。
WEIGHTS_AUTO_TUNE=false
WEIGHTS_AUTO_TUNE_MARGIN=0.02
WEIGHTS_AUTO_TUNE_MIN_SAMPLE=10
WEIGHTS_AUTO_TUNE_STEP=0.1
WEIGHTS_AUTO_TUNE_K=10

# ── §7 二期 PGVector 多语嵌入（默认关：none 走 TF-IDF，零依赖不变）──
# ⚠ 2026-09-25 实测记录（开启前必读）：多语 MiniLM 在本库上 vec 分主要在编码「JD 有
# 多长」而非语义匹配——mean-pooling 空间各向异性（全体职位对全局均值 cos=0.61），
# 空描述职位（Stripe/NVIDIA）对简历 ≈0.08、长描述职位（ElevenLabs/Ashby/Linear）
# ≈0.80 且同公司塌缩，海外榜被少数长 JD 公司占满。均值剥离无效；去 top-2 主成分
# （ABTT）实测有效但 k 极敏感。未解决该偏置前请保持 none，详见开发文档第二十四轮。
# 开启前提：DATABASE_URL 切 PG（pgvector 扩展）+ pip install sentence-transformers
# + 模型首次运行自动下载（HF 需代理，或设 HF_ENDPOINT=https://hf-mirror.com）
# 存量回填：python ../scripts/backfill_vectors.py（refresh 缺向量时也会现场补，但首次建议预热）
# 换模型时 EMBEDDINGS_MODEL 与 EMBEDDINGS_DIM 必须同步改：BAAI/bge-m3=1024、
# sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2=384；换后跑 --rebuild 全量重嵌。
# 模型取舍（本机 8 核 CPU 实测）：bge-m3 质量最好但 ~3s/条（全库 3.5h）；MiniLM 快 30 倍
# 以上（全库约 7 分钟）。两者都受上面的长度偏置影响，速度不是当前瓶颈。
EMBEDDINGS_PROVIDER=none
EMBEDDINGS_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDINGS_DIM=384
EMBEDDINGS_DEVICE=cpu
EMBEDDINGS_BATCH_SIZE=64
# 截断长度（0=模型自带默认）。MiniLM 默认仅 128，「标题+技能」就吃满、JD 正文被切掉；
# 512 才能让正文进向量。注意 MiniLM 的 max_position_embeddings=512 是硬上限，改大报错。
EMBEDDINGS_MAX_SEQ_LEN=512

# 生产：DATABASE_URL 切 PostgreSQL（先 pip install psycopg2-binary）；
# REDIS_URL 必须带口令且不对公网暴露（broker 承载任务与结果，且 Celery worker/beat 依赖它）
