# 复制为 .env 并按需修改
# SQLite 开箱即用；生产/联调切 PostgreSQL（先 pip install psycopg2-binary 并 docker compose up -d）
DATABASE_URL=sqlite:///./dev.db

# Redis（空 = 不启用，限流退化为 DB 间隔守卫）
REDIS_URL=

# 采集策略
FETCH_DEFAULT_INTERVAL_MIN=360
OFFICIAL_SITE_INTERVAL_MIN=720
TTL_MULTIPLIER=3

# §9 后台任务（需另起 celery worker/beat；开关默认 false = 请求内同步，投递失败自动降级）
RESUME_PARSE_ASYNC=false
MATCH_ASYNC=false
IDLE_JOBS_TTL_DAYS=14

# §12.7 #7 采集入库抽标签：词典扫描零成本永远开；LLM 兜底默认关（需 LLM_API_KEY，按 cap 限成本）
JOB_TAG_LLM=false
JOB_TAG_LLM_CAP=50

# ---------- §14 ⑤ 生产配置审计：密钥项 ----------
# 留空 = 该功能不启用（不是配置错误）；填写则必须是服务商签发的真实值——
# scripts/audit_production_config.py 只判长度与占位词，不打印原文、不改配置。
# 简历解析 LLM（DeepSeek / OpenAI 兼容接口；空 = 走规则兜底）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# 扫描件 PDF OCR（OpenAI 兼容视觉接口；空 = 不支持扫描件）
OCR_API_KEY=
OCR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OCR_MODEL=qwen-vl-plus
# 催进邮件通知（SMTP_HOST 空 = 不发邮件，beat 只打日志）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL=
# IM 群机器人（钉钉/企微；IM_WEBHOOK_TYPE 空 = 不推 IM）
IM_WEBHOOK_TYPE=
IM_WEBHOOK_URL=
IM_WEBHOOK_SECRET=

# 采集 UA 的联系邮箱：生产必须替换掉默认示例，否则站点按匿名爬虫处理
UA=job-direct-apply-bot/0.1 (compliant; contact: dev@example.com)

# 生产：DATABASE_URL 切 PostgreSQL（先 pip install psycopg2-binary）；
# REDIS_URL 必须带口令且不对公网暴露（broker 承载任务与结果，且 Celery worker/beat 依赖它）
